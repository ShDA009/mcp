# Zephyr Scale
ZEPHYR_BASE_URL=https://jira.example.com
ZEPHYR_API_TOKEN=changeme

# Включает пишущие tools (create_test_case, update_test_case, create_folder,
# create_test_run, add_test_cases_to_run). По умолчанию выключено, для включения — 1.
ZEPHYR_ALLOW_WRITE=1

# Включает необратимое удаление (delete_test_runs). Работает только вместе с
# ZEPHYR_ALLOW_WRITE. По умолчанию выключено, для включения — 1.
# ZEPHYR_ALLOW_DELETE=1