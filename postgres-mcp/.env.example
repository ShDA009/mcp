DATABASE_URI=postgresql://user:password@db.example.com:5432/dbname

# Читает лаунчер, а не сервер: серверу режим передаётся флагом --access-mode.
#   restricted   - только чтение, read-only транзакции (по умолчанию)
#   unrestricted - разрешены запись и DDL, только для дев-баз
PGMCP_ACCESS_MODE=restricted

# Опционально: альтернативная (LLM) стратегия подбора индексов.
# Без этих переменных основной подбор индексов работает, выключается только
# LLM-вариант. Сервер создаёт клиент как OpenAI() без аргументов, поэтому
# openai-SDK берёт адрес и ключ из окружения сам.
#
# В НАШЕМ КОНТУРЕ ЭТИ ПЕРЕМЕННЫЕ НЕ ЗАДАЮТСЯ. Имя модели захардкожено в
# upstream как "gpt-4o" (postgres_mcp/index/llm_opt.py), переменной окружения
# для него нет, а наш шлюз это имя не обслуживает - возвращает
# "No matching route found". Подробности - в README.md.
# OPENAI_BASE_URL=<адрес корпоративного шлюза>/v1
# OPENAI_API_KEY=<корп-ключ, шлюз требует настоящий>


PYTHONUNBUFFERED=1
