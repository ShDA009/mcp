# EWS_USERNAME - логин для NTLM без домена и без @suffix (напр. "ivanov", не "ivanov@example.com")
# EWS_EMAIL - полный SMTP-адрес почтового ящика (нужен exchangelib отдельно от NTLM-логина)
EWS_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_USERNAME=ivanov
EWS_EMAIL=ivanov@example.com
EWS_PASSWORD=changeme

# Optional, with defaults:
# OUTLOOK_MCP_TIMEZONE=Europe/Moscow
# OUTLOOK_MCP_DEFAULT_LIMIT=50
# OUTLOOK_MCP_MAX_LIMIT=200
