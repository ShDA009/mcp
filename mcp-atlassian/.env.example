# Confluence
CONFLUENCE_URL=https://wiki.example.com
CONFLUENCE_PERSONAL_TOKEN=your_confluence_personal_token_here

# Jira
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=your_jira_personal_token_here

# SSL verification (required for corporate proxies)
VERIFY_SSL=false
CONFLUENCE_SSL_VERIFY=false
JIRA_SSL_VERIFY=false
PYTHONHTTPSVERIFY=0
PYTHONUNBUFFERED=1

# CA bundle mount (for corporate certificates)
REQUESTS_CA_BUNDLE=/usr/local/share/ca-certificates/your-corporate-ca.crt
